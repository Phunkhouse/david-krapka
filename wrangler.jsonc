{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "david-krapka",
  "compatibility_date": "2026-11-04",
  // Static assets only, no Worker script. Headers live in public/_headers.
  "assets": {
    "directory": "./dist/",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Production answers only on david-krapka.eu (milestone 6 decision 8);
  // preview URLs stay on for PR review and carry noindex from Cloudflare.
  "workers_dev": false,
  "preview_urls": true,
  // Required by `wrangler preview` (non-production branch builds), even if empty.
  "previews": {},
}
