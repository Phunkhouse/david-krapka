# Remove X-Robots-Tag at launch (milestone 6).
# The Content-Security-Policy header only carries what a <meta> CSP cannot
# (frame-ancestors); inline styles and scripts are allowed by the hashed
# <meta> CSP Astro emits (security.csp in astro.config.mjs).
/*
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
