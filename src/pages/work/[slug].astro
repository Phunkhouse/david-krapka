---
import { render } from 'astro:content'
import { getCaseStudies } from '../../content/load'
import { caseStudyComponents } from '../../components/case-study/mdx'
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro'

export async function getStaticPaths() {
  const studies = await getCaseStudies('en')
  return studies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }))
}

const { study } = Astro.props
const { Content, headings } = await render(study)
---

<CaseStudyLayout study={study} headings={headings}>
  <Content components={caseStudyComponents} />
</CaseStudyLayout>
