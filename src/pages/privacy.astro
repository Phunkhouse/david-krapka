---
import BaseLayout from '../layouts/BaseLayout.astro'
import PrivacyNotice from '../components/PrivacyNotice.astro'
import { localeOf, t } from '../i18n'

const locale = localeOf(Astro.currentLocale)
const copy = t(locale)
---

<BaseLayout
  title={`${copy.privacy.title} · ${copy.site.name}`}
  description={copy.privacy.description}
  route="privacy"
>
  <PrivacyNotice title={copy.privacy.title} locale={locale} />
</BaseLayout>
