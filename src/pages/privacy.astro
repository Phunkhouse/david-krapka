---
import BaseLayout from '../layouts/BaseLayout.astro'
import PrivacyNotice from '../components/PrivacyNotice.astro'
import { t } from '../i18n'

const copy = t(Astro.currentLocale)
---

<BaseLayout
  title={`${copy.privacy.title} · ${copy.site.name}`}
  description={copy.privacy.description}
  route="privacy"
>
  <PrivacyNotice title={copy.privacy.title} locale={Astro.currentLocale} />
</BaseLayout>
