---
import BaseLayout from '../layouts/BaseLayout.astro'
import { t } from '../i18n'

const copy = t(Astro.currentLocale)
---

<BaseLayout
  title={`${copy.privacy.title} · ${copy.site.name}`}
  description={copy.privacy.description}
  route="privacy"
>
  <h1>{copy.privacy.title}</h1>
  <p>{copy.privacy.placeholder}</p>
</BaseLayout>
