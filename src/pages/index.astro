---
import BaseLayout from '../layouts/BaseLayout.astro'
import Approach from '../components/landing/Approach.astro'
import Experience from '../components/landing/Experience.astro'
import Hero from '../components/landing/Hero.astro'
import Work from '../components/landing/Work.astro'
import { isLocale, t } from '../i18n'

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : 'en'
const copy = t(locale)
---

<BaseLayout
  title={`${copy.site.name} · ${copy.site.role}`}
  description={copy.site.description}
  route="home"
  bleed
>
  <Hero locale={locale} />
  <Work locale={locale} />
  <Approach locale={locale} />
  <Experience locale={locale} />
</BaseLayout>
