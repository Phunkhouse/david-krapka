---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/landing/Hero.astro'
import Work from '../components/landing/Work.astro'
import { t } from '../i18n'

const locale = Astro.currentLocale === 'cs' ? 'cs' : 'en'
const copy = t(locale)
---

<BaseLayout
  title={`${copy.site.name} · ${copy.site.role}`}
  description={copy.site.description}
  route="home"
  bleed
>
  <Hero locale={locale} />
  <Work locale={locale} />
</BaseLayout>
