---
import { t } from '../../i18n'

interface Props {
  decided: string
  helped: string
  reviewed: string
}

const { decided, helped, reviewed } = Astro.props
const labels = t(Astro.currentLocale).caseStudy
const columns = [
  [labels.aiDecided, decided],
  [labels.aiHelped, helped],
  [labels.aiReviewed, reviewed],
]
---

<section class="ai" aria-label={labels.aiTitle}>
  <p class="title" lang="en">
    {labels.aiTitle}
  </p>
  <dl>
    {columns.map(([term, value]) => (
      <div>
        <dt class="label">{term}</dt>
        <dd>{value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .ai {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 18px;
    border: var(--border);
    background: var(--tint);
  }

  .title {
    font-family: var(--family-display);
    font-size: 22px;
    font-weight: 900;
    text-transform: uppercase;
  }

  dl {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
  }

  dl > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  dl > div + div {
    padding-top: 16px;
    border-top: 1px dashed var(--ink-line);
  }

  dt {
    font-size: 12px;
  }

  dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
  }

  @media (min-width: 720px) {
    .ai {
      padding: 24px;
    }

    dl {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    dl > div + div {
      padding-top: 0;
      padding-left: 20px;
      border-top: 0;
      border-left: 1px dashed var(--ink-line);
    }
  }
</style>
