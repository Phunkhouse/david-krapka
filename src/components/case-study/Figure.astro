---
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import { t } from '../../i18n'

interface Props {
  /** The screenshot, imported in the MDX file. Missing: a placeholder box. */
  src?: ImageMetadata
  /** What the screenshot shows, for people who cannot see it. Required. */
  alt: string
  caption: string
  /** Figure number on the page: "Fig. 1". */
  n: number
  /** Full content width on yellow paper (long form, after "The build"). */
  wide?: boolean
  /** Only for a screenshot in the first screen of the page. */
  priority?: boolean
}

const { src, alt, caption, n, wide = false, priority = false } = Astro.props
const labels = t(Astro.currentLocale).caseStudy
// Reading column: 720 px from 1100 px. Wide: the content width, up to 1216 px.
const widths = wide ? [390, 780, 1216, 1824, 2432] : [360, 720, 1080, 1440]
const sizes = wide
  ? '(min-width: 1440px) 1216px, (min-width: 720px) calc(100vw - 112px), calc(100vw - 40px)'
  : '(min-width: 1100px) 720px, (min-width: 720px) calc(100vw - 112px), calc(100vw - 40px)'
---

<figure class:list={['figure', { 'figure--wide': wide }]}>
  <div class:list={['mat', { 'paper-yellow': wide }]}>
    <div class="frame">
      {src ? (
        <Picture
          src={src}
          alt={alt}
          formats={['avif', 'webp']}
          widths={widths}
          sizes={sizes}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
        />
      ) : (
        <div class="placeholder" role="img" aria-label={alt}>
          <span>{alt}</span>
        </div>
      )}
    </div>
  </div>
  <figcaption>
    {labels.figure} {n} · {caption}
  </figcaption>
</figure>

<style>
  .figure {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
  }

  .frame {
    border: var(--border);
    background: var(--tint);
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    padding: 16px;
  }

  .placeholder span {
    padding: 6px 10px;
    background: var(--paper);
    font-family: var(--family-mono);
    font-size: 13px;
    text-align: center;
  }

  figcaption {
    font-family: var(--family-mono);
    font-size: 13px;
    line-height: 1.5;
  }

  /* Wide: the screenshot framed on yellow paper across the content width */
  .figure--wide .mat {
    padding: 20px;
    border-block: var(--border);
  }

  .figure--wide .frame {
    background: var(--paper);
    box-shadow: 6px 6px 0 var(--pink);
  }

  .figure--wide .placeholder {
    aspect-ratio: 16 / 9;
  }

  .figure--wide .placeholder span {
    background: var(--tint);
  }

  @media (min-width: 720px) {
    .figure--wide .mat {
      padding: 64px var(--pad-inline);
    }

    .figure--wide .frame {
      box-shadow: 12px 12px 0 var(--pink);
    }
  }
</style>
