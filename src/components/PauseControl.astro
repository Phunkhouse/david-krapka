---
import { t, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

// Hidden until JavaScript runs, because it would do nothing without it.
const { locale } = Astro.props
const copy = t(locale)
---

<button
  class="pause"
  type="button"
  data-pause
  data-label-stop={copy.pause.stop}
  data-label-start={copy.pause.start}
  data-state="playing"
  aria-label={copy.pause.stop}
  title={copy.pause.stop}
  hidden
>
  <span class="icon" aria-hidden="true">
    <span></span>
    <span></span>
  </span>
</button>

<script>
  // Milestone 4: stops and starts every decorative loop on the page
  // (WCAG 2.2.2). The state lives in this variable only: no cookie,
  // localStorage, sessionStorage or IndexedDB (LEG-005).
  //
  // Classes on <html>:
  //   motion  motion layout and animations are on. A <head> script in
  //           BaseLayout sets it before first paint unless the visitor
  //           prefers reduced motion; pressing "Start the press" sets it
  //           for this page view.
  //   paused  every loop inside [data-loop] holds its current frame.
  // Loops also hold while their [data-loop] section is off-screen.
  const root = document.documentElement
  const reduced = matchMedia('(prefers-reduced-motion: reduce)')
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-pause]')

  let paused = reduced.matches

  const render = () => {
    root.classList.toggle('paused', paused)
    buttons.forEach((button) => {
      button.hidden = false
      button.dataset.state = paused ? 'paused' : 'playing'
      // Icon only: the name lives in aria-label, with the same text as a
      // tooltip.
      const label =
        (paused ? button.dataset.labelStart : button.dataset.labelStop) ?? ''
      button.setAttribute('aria-label', label)
      button.title = label
    })
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      paused = !paused
      // Under reduced motion the page starts static; starting the press
      // switches to the motion layout for this page view.
      if (!paused) root.classList.add('motion')
      render()
    })
  })

  // The system preference wins: if it changes during the visit, follow it,
  // even over a press the visitor stopped by hand.
  reduced.addEventListener('change', () => {
    paused = reduced.matches
    root.classList.toggle('motion', !reduced.matches)
    render()
  })

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle('offscreen', !entry.isIntersecting)
      })
    })
    document
      .querySelectorAll('[data-loop]')
      .forEach((section) => observer.observe(section))
  }

  render()
</script>

<style>
  /* shell-components.md#pause-control */
  /* Icon only, a round 44 px button (comfortable tap target); its name is
     the aria-label set below. */
  .pause {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: var(--border);
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 4px 4px 0 rgb(255 72 176 / 0.6);
    color: var(--ink);
    cursor: pointer;
  }

  /* The hidden attribute must win over display: inline-flex. */
  .pause[hidden] {
    display: none;
  }

  .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--ink);
  }

  .icon span {
    width: 3px;
    height: 11px;
    background: var(--yellow);
  }

  /* Paused: the icon turns into a play triangle. */
  .pause[data-state='paused'] .icon span {
    display: none;
  }

  .pause[data-state='paused'] .icon::after {
    content: '';
    margin-left: 2px;
    border-left: 10px solid var(--yellow);
    border-block: 6px solid transparent;
  }
</style>
