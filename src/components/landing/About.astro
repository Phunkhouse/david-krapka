---
import { t, type Locale } from '../../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { about } = t(locale).home
const [before, highlighted, after] = about.title
---

<!--
  G4 portrait of David in two inks: a duotone ink layer and a pink halftone
  copy slipped out of register, both CSS masks built from the photo by
  scripts/portrait.mjs. .still is the static state (reduced motion, no
  JavaScript): inks at rest, no scan bar. Under html.motion it is swapped for
  the glitch layers: six horizontal strips with the same two inks, plus the
  scan bar (7 s loop), and the pink dot circle drifts (4 s).
  data-loop: the pause control and the off-screen pause apply.
-->
<section
  id="about"
  class="about"
  tabindex="-1"
  aria-labelledby="about-title"
  data-loop
>
  <div class="inner">
    <div class="portrait" role="img" aria-label={about.portrait}>
      <span class="screen dots-pink"></span>
      <div class="frame paper-yellow">
        <div class="still">
          <div class="ink ink--pink"></div>
          <div class="ink ink--blue"></div>
        </div>
        <div class="glitch">
          {[0, 1, 2, 3, 4, 5].map((strip) => (
            <div class={`strip strip--${strip}`}>
              <div class="ink ink--pink"></div>
              <div class="ink ink--blue"></div>
            </div>
          ))}
          <div class="bar"></div>
        </div>
      </div>
    </div>

    <div class="text">
      <p class="label">{about.eyebrow}</p>
      <h2 id="about-title">
        {before}
        <span class="highlight">{highlighted}</span>
        {after}
      </h2>
      <p class="body">
        {about.text} {about.note}
      </p>
    </div>
  </div>
</section>

<style>
  .about:focus {
    outline: none;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-m);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--pad-section) var(--pad-inline);
  }

  /* Portrait: yellow paper circle, ink border, pink dot circle offset behind. */
  .portrait {
    /* Scale of the 400 px design (see the motion block below). */
    --u: 0.6;
    /* Portrait size in px; the scan bar keyframes use it. */
    --size: calc(var(--u) * 400px);

    position: relative;
    flex: none;
    width: 240px;
    height: 240px;
    align-self: center;
  }

  .screen {
    position: absolute;
    inset: 26px -10px -10px 26px;
    border-radius: 50%;
    mix-blend-mode: multiply;
    opacity: 0.7;
  }

  .frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: var(--border);
    border-radius: 50%;
    /* Safari does not clip transformed, masked or blended children to a
       rounded overflow box: the photo spilled out as a square at the
       bottom. A circular clip-path and its own stacking context make
       WebKit clip them like other browsers do. */
    clip-path: circle(50%);
    isolation: isolate;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 640px;
  }

  h2 {
    font-size: var(--text-about);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }

  .highlight {
    padding-inline: 4px;
  }

  .body {
    font-size: var(--text-body-lg);
    line-height: 1.65;
  }

  @media (min-width: 720px) {
    .portrait {
      --u: 0.8;

      width: 320px;
      height: 320px;
      align-self: flex-start;
    }

    .screen {
      inset: 32px -13px -13px 32px;
    }

    .inner {
      gap: var(--gap-xl);
    }

    .highlight {
      padding-inline: 6px;
    }
  }

  @media (min-width: 1100px) {
    .inner {
      display: grid;
      grid-template-columns: 400px minmax(0, 1fr);
      align-items: center;
      gap: 72px;
    }

    .portrait {
      --u: 1;

      width: 400px;
      height: 400px;
    }

    .screen {
      inset: 40px -16px -16px 40px;
    }
  }

  /* ---------------------------------------------------------------------
     Motion (milestone 4): G4 ink slip and roller jam. --u scales the
     400 px design to the portrait size, so jumps and dots keep their
     proportions. Only under html.motion.
     --------------------------------------------------------------------- */
  .glitch {
    display: none;
    position: absolute;
    inset: 0;
  }

  :global(html.motion) .glitch {
    display: block;
  }

  :global(html.motion) .still {
    display: none;
  }

  :global(html.motion) .screen {
    animation: drift 4s ease-in-out infinite;
  }

  .strip {
    position: absolute;
    inset: 0;
    animation-duration: 7s;
    animation-timing-function: steps(1, end);
    animation-iteration-count: infinite;
  }

  .strip--0 {
    clip-path: inset(0% 0 82% 0);
    animation-name: slip-0;
  }

  .strip--1 {
    clip-path: inset(18% 0 64% 0);
    animation-name: slip-1;
  }

  .strip--2 {
    clip-path: inset(36% 0 48% 0);
    animation-name: slip-2;
  }

  .strip--3 {
    clip-path: inset(52% 0 30% 0);
    animation-name: slip-3;
  }

  .strip--4 {
    clip-path: inset(70% 0 14% 0);
    animation-name: slip-4;
  }

  .strip--5 {
    clip-path: inset(86% 0 0% 0);
    animation-name: slip-5;
  }

  /* Isolated like each animated strip (transform and clip-path isolate them),
     so the pink copy blends the same way in the static and the motion state. */
  .still {
    position: absolute;
    inset: 0;
    isolation: isolate;
  }

  /* One ink layer: a colour masked by an image made from the photo. */
  .ink {
    position: absolute;
    inset: 0;
    animation-duration: 7s;
    animation-timing-function: steps(1, end);
    animation-iteration-count: infinite;
  }

  /* Duotone: ink where the photo is dark, paper where it is light. */
  .ink--blue {
    background-color: var(--ink);
    -webkit-mask: url('../../assets/portrait/portrait-ink.webp') center / 100%
      100% no-repeat;
    mask: url('../../assets/portrait/portrait-ink.webp') center / 100% 100%
      no-repeat;
    animation-name: ink-blue;
  }

  /* Pink halftone copy, slipped right and down behind the ink. */
  .ink--pink {
    background-color: var(--pink);
    -webkit-mask: url('../../assets/portrait/portrait-pink.svg') center / 100%
      100% no-repeat;
    mask: url('../../assets/portrait/portrait-pink.svg') center / 100% 100%
      no-repeat;
    mix-blend-mode: multiply;
    opacity: 0.6;
    animation-name: ink-pink;
  }

  /* Static state: the pink copy at its resting register (the glitch keyframes
     start from the same offset). */
  .still .ink--pink {
    transform: translate(calc(var(--u) * 8px), calc(var(--u) * 6px));
    animation: none;
  }

  .still .ink--blue {
    animation: none;
  }

  .bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: calc(var(--u) * 14px);
    background: var(--pink);
    mix-blend-mode: multiply;
    opacity: 0;
    animation: bar 7s linear infinite;
  }

  @keyframes ink-pink {
    0%,
    62% {
      transform: translate(calc(var(--u) * 8px), calc(var(--u) * 6px));
    }
    63% {
      transform: translate(calc(var(--u) * -22px), calc(var(--u) * 10px));
    }
    64% {
      transform: translate(calc(var(--u) * 18px), calc(var(--u) * -8px))
        skewX(-8deg);
    }
    65.5% {
      transform: translate(calc(var(--u) * -6px), calc(var(--u) * 4px));
    }
    67%,
    88% {
      transform: translate(calc(var(--u) * 8px), calc(var(--u) * 6px));
    }
    88.6% {
      transform: translate(calc(var(--u) * 26px), 0);
    }
    89.4%,
    100% {
      transform: translate(calc(var(--u) * 8px), calc(var(--u) * 6px));
    }
  }

  @keyframes ink-blue {
    0%,
    63% {
      transform: translate(0, 0);
    }
    63.6% {
      transform: translate(calc(var(--u) * 12px), calc(var(--u) * -6px));
    }
    64.8% {
      transform: translate(calc(var(--u) * -10px), calc(var(--u) * 3px));
    }
    66%,
    89% {
      transform: translate(0, 0);
    }
    89.6% {
      transform: translate(calc(var(--u) * -8px), 0) scaleY(1.04);
    }
    90.4%,
    100% {
      transform: translate(0, 0);
    }
  }

  /* The scan bar sweeps down the portrait (top -10 % → 110 %), moved with
     transform instead of top so nothing triggers layout. */
  @keyframes bar {
    0%,
    57% {
      opacity: 0;
      transform: translateY(calc(var(--size) * -0.1));
    }
    58% {
      opacity: 1;
      transform: translateY(calc(var(--size) * 0.1));
    }
    62% {
      opacity: 1;
      transform: translateY(calc(var(--size) * 0.7));
    }
    63%,
    100% {
      opacity: 0;
      transform: translateY(calc(var(--size) * 1.1));
    }
  }

  @keyframes slip-0 {
    0%,
    58.0% {
      transform: translateX(0);
    }
    58.6% {
      transform: translateX(calc(var(--u) * 14px));
    }
    60.2% {
      transform: translateX(calc(var(--u) * -26px));
    }
    61.4%,
    84.0% {
      transform: translateX(0);
    }
    84.6% {
      transform: translateX(calc(var(--u) * -26px));
    }
    85.4%,
    100% {
      transform: translateX(0);
    }
  }

  @keyframes slip-1 {
    0%,
    58.7% {
      transform: translateX(0);
    }
    59.3% {
      transform: translateX(calc(var(--u) * -18px));
    }
    60.9% {
      transform: translateX(calc(var(--u) * 10px));
    }
    62.1%,
    84.5% {
      transform: translateX(0);
    }
    85.1% {
      transform: translateX(calc(var(--u) * 10px));
    }
    85.9%,
    100% {
      transform: translateX(0);
    }
  }

  @keyframes slip-2 {
    0%,
    59.4% {
      transform: translateX(0);
    }
    60.0% {
      transform: translateX(calc(var(--u) * 30px));
    }
    61.6% {
      transform: translateX(calc(var(--u) * -8px));
    }
    62.8%,
    85.0% {
      transform: translateX(0);
    }
    85.6% {
      transform: translateX(calc(var(--u) * -8px));
    }
    86.4%,
    100% {
      transform: translateX(0);
    }
  }

  @keyframes slip-3 {
    0%,
    60.1% {
      transform: translateX(0);
    }
    60.7% {
      transform: translateX(calc(var(--u) * -12px));
    }
    62.3% {
      transform: translateX(calc(var(--u) * 22px));
    }
    63.5%,
    85.5% {
      transform: translateX(0);
    }
    86.1% {
      transform: translateX(calc(var(--u) * 22px));
    }
    86.9%,
    100% {
      transform: translateX(0);
    }
  }

  @keyframes slip-4 {
    0%,
    60.8% {
      transform: translateX(0);
    }
    61.4% {
      transform: translateX(calc(var(--u) * 22px));
    }
    63.0% {
      transform: translateX(calc(var(--u) * -16px));
    }
    64.2%,
    86.0% {
      transform: translateX(0);
    }
    86.6% {
      transform: translateX(calc(var(--u) * -16px));
    }
    87.4%,
    100% {
      transform: translateX(0);
    }
  }

  @keyframes slip-5 {
    0%,
    61.5% {
      transform: translateX(0);
    }
    62.1% {
      transform: translateX(calc(var(--u) * -26px));
    }
    63.7% {
      transform: translateX(calc(var(--u) * 6px));
    }
    64.9%,
    86.5% {
      transform: translateX(0);
    }
    87.1% {
      transform: translateX(calc(var(--u) * 6px));
    }
    87.9%,
    100% {
      transform: translateX(0);
    }
  }

  @keyframes drift {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: calc(var(--u) * 6px) calc(var(--u) * -4px);
    }
  }
</style>
