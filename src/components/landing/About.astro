---
import { t, type Locale } from '../../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { about } = t(locale).home
const [before, highlighted, after] = about.title
---

<!--
  Static state of the G4 portrait glitch: inks in their resting register, no
  scan bar. The silhouette stands in for the photo; the real photo gets the
  same two-ink halftone once it exists (docs/design/visual-system.md).
  Milestone 4 adds the glitch loop.
-->
<section id="about" class="about" tabindex="-1" aria-labelledby="about-title">
  <div class="inner">
    <div class="portrait" aria-hidden="true">
      <span class="screen dots-pink"></span>
      <div class="frame paper-yellow">
        <svg viewBox="0 0 400 400" focusable="false">
          <defs>
            <pattern
              id="dots-ink"
              width="9"
              height="9"
              patternUnits="userSpaceOnUse"
            >
              <circle class="dot-ink" cx="4.5" cy="4.5" r="2.6"></circle>
            </pattern>
            <pattern
              id="dots-pink"
              width="9"
              height="9"
              patternUnits="userSpaceOnUse"
            >
              <circle class="dot-pink" cx="4.5" cy="4.5" r="2.6"></circle>
            </pattern>
            <g id="silhouette">
              <ellipse cx="200" cy="165" rx="72" ry="88"></ellipse>
              <rect x="168" y="230" width="64" height="50"></rect>
              <path d="M50 400 C60 300 125 262 200 262 C275 262 340 300 350 400 Z"></path>
            </g>
          </defs>
          <use
            class="ink-pink"
            href="#silhouette"
            fill="url(#dots-pink)"
            transform="translate(8 6)"
          ></use>
          <use href="#silhouette" fill="url(#dots-ink)"></use>
        </svg>
      </div>
    </div>

    <div class="text">
      <p class="label">{about.eyebrow}</p>
      <h2 id="about-title">
        {before}
        <span class="highlight">{highlighted}</span>
        {after}
      </h2>
      <p class="body">
        {about.text} {about.note}
      </p>
    </div>
  </div>
</section>

<style>
  .about:focus {
    outline: none;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-m);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--pad-section) var(--pad-inline);
  }

  /* Portrait: yellow paper circle, ink border, pink dot circle offset behind. */
  .portrait {
    position: relative;
    flex: none;
    width: 240px;
    height: 240px;
    align-self: center;
  }

  .screen {
    position: absolute;
    inset: 26px -10px -10px 26px;
    border-radius: 50%;
    mix-blend-mode: multiply;
    opacity: 0.7;
  }

  .frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: var(--border);
    border-radius: 50%;
  }

  svg {
    width: 100%;
    height: 100%;
  }

  .dot-ink {
    fill: var(--ink);
  }

  .dot-pink {
    fill: var(--pink);
  }

  .ink-pink {
    mix-blend-mode: multiply;
    opacity: 0.75;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 640px;
  }

  h2 {
    font-size: var(--text-about);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }

  .highlight {
    padding-inline: 4px;
  }

  .body {
    font-size: var(--text-body-lg);
    line-height: 1.65;
  }

  @media (min-width: 720px) {
    .portrait {
      width: 320px;
      height: 320px;
      align-self: flex-start;
    }

    .screen {
      inset: 32px -13px -13px 32px;
    }

    .inner {
      gap: var(--gap-xl);
    }

    .highlight {
      padding-inline: 6px;
    }
  }

  @media (min-width: 1100px) {
    .inner {
      display: grid;
      grid-template-columns: 400px minmax(0, 1fr);
      align-items: center;
      gap: 72px;
    }

    .portrait {
      width: 400px;
      height: 400px;
    }

    .screen {
      inset: 40px -16px -16px 40px;
    }
  }
</style>
