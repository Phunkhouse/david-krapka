---
import SectionHeading from '../SectionHeading.astro'
import { t, type Locale } from '../../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = t(locale).home
const { approach } = copy
// One halftone letter per step; the middle column is yellow paper with a
// pink misregistered copy.
const letters = ['T', 'M', 'R']
---

<!--
  Static state of the A5 approach motion: letters fully developed, columns at
  rest (also the reduced-motion look). Milestone 4 adds the develop-once
  animation and the hover reactions (docs/design/motion.md).
-->
<section
  id="approach"
  class="approach"
  tabindex="-1"
  aria-labelledby="approach-title"
>
  <div class="inner">
    <div class="heading">
      <SectionHeading id="approach-title">{approach.title}</SectionHeading>
      <p class="intro">
        <span class="long">{approach.intro}</span>
        <span class="short">{approach.introShort}</span>
      </p>
    </div>

    <ol
      class="columns rollers rollers--thin"
      role="list"
      aria-label={approach.listLabel}
    >
      {approach.steps.map((step, index) => (
        <li class:list={['col', index === 1 && 'paper-yellow']}>
          {index === 1 && (
            <span class="letter letter--pink" aria-hidden="true">
              {letters[index]}
            </span>
          )}
          <span
            class:list={[
              'letter',
              'halftone',
              'halftone--sm',
              `letter--${index}`,
            ]}
            aria-hidden="true"
          >
            {letters[index]}
          </span>
          <p class="label counter">{step.counter}</p>
          <h3>
            {step.title.startsWith(copy.hero.highlight) ? (
              <>
                <span class="highlight">{copy.hero.highlight}</span>
                {step.title.slice(copy.hero.highlight.length)}
              </>
            ) : (
              step.title
            )}
          </h3>
          <p class="text">
            <span class="long">{step.text}</span>
            <span class="short">{step.textShort}</span>
          </p>
        </li>
      ))}
    </ol>

    <div class="ai">
      <p class="tag">{approach.ai.tag}</p>
      <p class="ai-text">
        <span class="long">{approach.ai.text}</span>
        <span class="short">{approach.ai.textShort}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .approach:focus {
    outline: none;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-l);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--pad-section) var(--pad-inline);
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .intro {
    max-width: 440px;
    font-size: var(--text-body-lg);
  }

  .long {
    display: none;
  }

  /* Three columns between two rollers; stacked on mobile and tablet. */
  .columns {
    --roller-width: 14px;

    display: flex;
    flex-direction: column;
    padding: 0;
    border-block: var(--border);
    list-style: none;
  }

  .col {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 170px;
    padding: var(--gap-m);
    overflow: hidden;
    isolation: isolate;
  }

  .col + .col {
    border-top: var(--border);
  }

  .col h3 {
    font-size: var(--text-approach);
  }

  .text {
    max-width: 168px;
    line-height: 1.55;
  }

  .counter,
  .col h3,
  .text {
    position: relative;
  }

  /* Halftone letters bleed off the bottom right and sit behind the text. */
  .letter {
    position: absolute;
    right: -10px;
    bottom: -26px;
    font-family: var(--family-display);
    font-weight: 900;
    font-size: 128px;
    line-height: 1;
    --dot: 2px;
    --grid: 7px;
    z-index: -1;
  }

  .letter--1 {
    right: -12px;
  }

  .letter--2 {
    right: -4px;
  }

  /* Pink copy of the M: slips right and up behind the halftone. */
  .letter--pink {
    right: -6px;
    bottom: -22px;
    z-index: -2;
    color: var(--pink);
    opacity: 0.45;
    mix-blend-mode: multiply;
  }

  /* "AI + me" strip on tint */
  .ai {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    padding: var(--gap-m);
    background: var(--tint);
  }

  .tag {
    align-self: flex-start;
    padding: 6px 10px;
    background: var(--ink);
    color: var(--yellow);
    font-family: var(--family-mono);
    font-size: 13px;
    font-weight: 700;
  }

  .ai-text {
    max-width: 820px;
    font-size: var(--text-body-lg);
    line-height: 1.6;
  }

  @media (min-width: 720px) {
    .heading {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--gap-m);
    }

    .inner {
      gap: var(--gap-2xl);
    }

    .long {
      display: inline;
    }

    .short {
      display: none;
    }

    .ai {
      flex-direction: row;
      align-items: flex-start;
      gap: 32px;
      padding: 36px;
    }

    .tag {
      flex: 0 0 auto;
      font-size: 14px;
      padding: 8px 12px;
    }

    .ai-text {
      flex: 1;
      min-width: 0;
    }

    .text {
      max-width: 300px;
    }

    .col {
      min-height: 220px;
      padding: 32px;
    }

    .letter {
      bottom: -50px;
      font-size: 240px;
    }

    .letter--pink {
      bottom: -46px;
    }
  }

  @media (min-width: 1100px) {
    .columns {
      --roller-width: 18px;

      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .col {
      gap: var(--gap-s);
      min-height: 380px;
      padding: 40px;
    }

    .col + .col {
      border-top: 0;
      border-left: var(--border);
    }

    .col:first-child {
      padding-left: 52px;
    }

    .col:last-child {
      padding-right: 52px;
    }

    .col h3 {
      font-size: var(--text-approach);
    }

    .text {
      font-size: 17px;
      line-height: 1.6;
    }

    .letter {
      --dot: 2.2px;
      --grid: 8px;

      right: -10px;
      bottom: -80px;
      font-size: 320px;
    }

    .letter--1 {
      right: -14px;
    }

    .letter--2 {
      right: 6px;
    }

    .letter--pink {
      right: -4px;
      bottom: -74px;
    }
  }
</style>
