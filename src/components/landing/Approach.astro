---
import SectionHeading from '../SectionHeading.astro'
import { t, type Locale } from '../../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = t(locale).home
const { approach } = copy
// One halftone letter per step; the middle column is yellow paper with a
// pink misregistered copy.
const letters = ['T', 'M', 'R']
---

<!--
  A5 approach motion (docs/design/motion.md). The markup and base styles are
  the static state: letters developed, columns at rest (the reduced-motion
  and no-JavaScript look). Under html.motion the script below arms the section
  (hides the start state) and plays the develop-once animation when the
  columns first scroll into view. Hover reactions are CSS only.
-->
<section
  id="approach"
  class="approach"
  tabindex="-1"
  aria-labelledby="approach-title"
>
  <div class="inner">
    <div class="heading">
      <SectionHeading id="approach-title">{approach.title}</SectionHeading>
      <p class="intro">
        <span class="long">{approach.intro}</span>
        <span class="short">{approach.introShort}</span>
      </p>
    </div>

    <ol
      class="columns rollers rollers--thin"
      role="list"
      aria-label={approach.listLabel}
    >
      {approach.steps.map((step, index) => (
        <li class:list={['col', index === 1 && 'paper-yellow']}>
          {index === 1 && (
            <span class="letter letter--pink" aria-hidden="true">
              {letters[index]}
            </span>
          )}
          <span
            class:list={[
              'letter',
              'halftone',
              'halftone--sm',
              `letter--${index}`,
            ]}
            aria-hidden="true"
          >
            {letters[index]}
          </span>
          <p class="label counter">{step.counter}</p>
          <h3 lang={locale === 'en' ? undefined : 'en'}>
            {/* The highlight follows the hero claim on purpose ("Re" in Rethink). */}
            {step.title.startsWith(copy.hero.highlight) ? (
              <>
                <span class="highlight">{copy.hero.highlight}</span>
                {step.title.slice(copy.hero.highlight.length)}
              </>
            ) : (
              step.title
            )}
          </h3>
          <p class="text">
            <span class="long">{step.text}</span>
            <span class="short">{step.textShort}</span>
          </p>
        </li>
      ))}
    </ol>

    <div class="ai">
      <p class="tag">{approach.ai.tag}</p>
      <p class="ai-text">
        <span class="long">{approach.ai.text}</span>
        <span class="short">{approach.ai.textShort}</span>
      </p>
    </div>
  </div>
</section>

<script>
  // Develop once: arm the section (start state), then play when the columns
  // first scroll into view. If this never runs, or the browser has no
  // IntersectionObserver, nothing is armed and the static state shows.
  const section = document.querySelector<HTMLElement>('#approach')
  const columns = section?.querySelector('.columns')
  if (
    section &&
    columns &&
    document.documentElement.classList.contains('motion') &&
    'IntersectionObserver' in window
  ) {
    section.dataset.develop = 'armed'
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          section.dataset.develop = 'play'
          observer.disconnect()
        }
      },
      { threshold: 0.1 },
    )
    observer.observe(columns)
  }
</script>

<style>
  .approach:focus {
    outline: none;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-l);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--pad-section) var(--pad-inline);
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .intro {
    max-width: 440px;
    font-size: var(--text-body-lg);
  }

  .long {
    display: none;
  }

  /* Three columns between two rollers; stacked on mobile and tablet. */
  .columns {
    --roller-width: 14px;

    display: flex;
    flex-direction: column;
    padding: 0;
    border-block: var(--border);
    list-style: none;
  }

  .col {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 170px;
    padding: var(--gap-m);
    overflow: hidden;
    isolation: isolate;
  }

  .col + .col {
    border-top: var(--border);
  }

  .col h3 {
    font-size: var(--text-approach);
  }

  /* Semibold (the site has Sora 400, 600 and 700): readable over the faded letters. */
  .text {
    max-width: 168px;
    font-weight: 600;
    line-height: 1.55;
  }

  .counter,
  .col h3,
  .text {
    position: relative;
  }

  /* Halftone letters bleed off the bottom right and sit behind the text.
     Faded so the text stays readable over them, also when a letter lifts into
     the copy on hover (David, 5 November 2026). */
  .letter {
    --letter-fade: 0.12;

    position: absolute;
    opacity: var(--letter-fade);
    right: -10px;
    bottom: -26px;
    font-family: var(--family-display);
    font-weight: 900;
    font-size: 128px;
    line-height: 1;
    --dot: 2px;
    --grid: 7px;
    z-index: -1;
  }

  .letter--1 {
    right: -12px;
  }

  .letter--2 {
    right: -4px;
  }

  /* Pink copy of the M: slips right and up behind the halftone. */
  .letter--pink {
    right: -6px;
    bottom: -22px;
    z-index: -2;
    color: var(--pink);
    opacity: var(--letter-fade);
    mix-blend-mode: multiply;
  }

  /* "AI + me" strip on tint */
  .ai {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    padding: var(--gap-m);
    background: var(--tint);
  }

  .tag {
    align-self: flex-start;
    padding: 6px 10px;
    background: var(--ink);
    color: var(--yellow);
    font-family: var(--family-mono);
    font-size: 13px;
    font-weight: 700;
  }

  .ai-text {
    max-width: 820px;
    font-size: var(--text-body-lg);
    line-height: 1.6;
  }

  @media (min-width: 720px) {
    .heading {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--gap-m);
    }

    .inner {
      gap: var(--gap-2xl);
    }

    .long {
      display: inline;
    }

    .short {
      display: none;
    }

    .ai {
      flex-direction: row;
      align-items: flex-start;
      gap: 32px;
      padding: 36px;
    }

    .tag {
      flex: 0 0 auto;
      font-size: 14px;
      padding: 8px 12px;
    }

    .ai-text {
      flex: 1;
      min-width: 0;
    }

    .text {
      max-width: 300px;
    }

    .col {
      min-height: 220px;
      padding: 32px;
    }

    .letter {
      bottom: -50px;
      font-size: 240px;
    }

    .letter--pink {
      bottom: -46px;
    }
  }

  @media (min-width: 1100px) {
    .columns {
      --roller-width: 18px;

      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .col {
      gap: var(--gap-s);
      min-height: 380px;
      padding: 40px;
    }

    .col + .col {
      border-top: 0;
      border-left: var(--border);
    }

    .col:first-child {
      padding-left: 52px;
    }

    .col:last-child {
      padding-right: 52px;
    }

    .text {
      font-size: 17px;
      line-height: 1.6;
    }

    .letter {
      --dot: 2.2px;
      --grid: 8px;

      right: -10px;
      bottom: -80px;
      font-size: 320px;
    }

    .letter--1 {
      right: -14px;
    }

    .letter--2 {
      right: 6px;
    }

    .letter--pink {
      right: -4px;
      bottom: -74px;
    }
  }

  /* ---------------------------------------------------------------------
     Motion (milestone 4): A5. Not a loop, so the pause control leaves it
     alone; under reduced motion nothing here applies.
     --------------------------------------------------------------------- */
  .col:nth-child(1) {
    --delay: 0.2s;
  }

  .col:nth-child(2) {
    --delay: 0.45s;
  }

  .col:nth-child(3) {
    --delay: 0.7s;
  }

  /* Start state, only while armed or playing. The end state after play is
     held by animation-fill-mode: both on the animations below: keep the fill.
     The dot radius --r is a
     registered property (global.css); without support the letters appear. */
  :global(html.motion) .approach[data-develop] .letter:not(.letter--pink) {
    --r: 0px;

    background-image: radial-gradient(
      var(--ink) var(--r),
      transparent calc(var(--r) + 0.4px)
    );
  }

  :global(html.motion) .approach[data-develop='armed'] .letter--pink {
    opacity: 0;
    transform: translate(18px, -14px);
  }

  :global(html.motion)
    .approach[data-develop='armed']
    :is(.counter, h3, .text) {
    opacity: 0;
  }

  :global(html.motion)
    .approach[data-develop='play']
    .letter:not(.letter--pink) {
    /* Six steps, not a smooth ramp: a gradient change repaints the letters on
       the main thread, so each step is one paint instead of one per frame. */
    animation: develop 1.6s steps(6, end) var(--delay) both;
  }

  :global(html.motion) .approach[data-develop='play'] .letter--pink {
    animation: register 1.4s ease-out var(--delay) both;
  }

  :global(html.motion) .approach[data-develop='play'] :is(.counter, h3, .text) {
    animation: fade-in 0.9s ease-out var(--delay) both;
  }

  @keyframes develop {
    from {
      --r: 0px;
    }
    to {
      --r: var(--dot);
    }
  }

  @keyframes register {
    from {
      opacity: 0;
      transform: translate(18px, -14px);
    }
    to {
      opacity: var(--letter-fade);
      transform: translate(0, 0);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Printing before the section was ever scrolled to: show the final state. */
  @media print {
    :global(html.motion) .approach[data-develop] .letter:not(.letter--pink) {
      --r: var(--dot);
    }

    :global(html.motion) .approach[data-develop] .letter--pink {
      opacity: var(--letter-fade);
      transform: none;
    }

    :global(html.motion) .approach[data-develop] :is(.counter, h3, .text) {
      opacity: 1;
      filter: none;
    }
  }

  /* Hover: the column under the pointer turns yellow and its letter lifts.
     Hover-capable devices only; the lift and tilt only without a
     reduced-motion preference. */
  @media (hover: hover) {
    .col {
      transition: background-color 0.35s ease;
    }

    .col h3 {
      transition: translate 0.35s ease;
    }

    .col h3 .highlight {
      transition:
        background-color 0.35s ease,
        color 0.35s ease;
    }

    .letter {
      transition:
        translate 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
        rotate 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .col:hover {
      background-color: var(--yellow);
    }

    .columns:hover .col:not(:hover) {
      background-color: var(--paper);
    }

    .col:hover h3 .highlight {
      background-color: var(--ink);
      color: var(--yellow);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .col:hover .letter:not(.letter--pink) {
      translate: 0 -36px;
      rotate: -4deg;
    }

    .col:hover .letter--pink {
      translate: 14px -26px;
      rotate: -4deg;
    }

    .col:hover h3 {
      translate: 8px 0;
    }
  }
</style>
