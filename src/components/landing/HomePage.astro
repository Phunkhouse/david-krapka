---
import BaseLayout from '../../layouts/BaseLayout.astro'
import About from './About.astro'
import Approach from './Approach.astro'
import Contact from './Contact.astro'
import Experience from './Experience.astro'
import Hero from './Hero.astro'
import PersonSchema from './PersonSchema.astro'
import Work from './Work.astro'
import { t, type Locale } from '../../i18n'

interface Props {
  locale: Locale
}

// The landing page in one language. src/pages/index.astro and
// src/pages/cs/index.astro both render it, so the section order lives here.
const { locale } = Astro.props
const copy = t(locale)
---

<BaseLayout
  title={`${copy.site.name} · ${copy.site.role}`}
  description={copy.site.description}
  route="home"
  bleed
>
  <PersonSchema locale={locale} slot="head" />
  <Hero locale={locale} />
  <Work locale={locale} />
  <Approach locale={locale} />
  <Experience locale={locale} />
  <About locale={locale} />
  <Contact locale={locale} />
</BaseLayout>
