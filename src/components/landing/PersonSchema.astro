---
import { t, type Locale } from '../../i18n'
import { urlFor } from '../../i18n/routes'
import { profiles } from '../../content/profiles'

interface Props {
  locale: Locale
}

// schema.org Person for search engines (landing pages only); `sameAs` lists
// the external profiles.
const { locale } = Astro.props
const copy = t(locale)
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: copy.site.name,
  jobTitle: copy.site.role,
  description: copy.site.description,
  url: urlFor(locale, 'home'),
  sameAs: [profiles.linkedin, profiles.github],
}
// A data block, not a script: CSP does not apply. Escape "<" so the JSON can
// never close the element.
const json = JSON.stringify(person).replace(/</g, '\\u003c')
---

<script type="application/ld+json" is:inline set:html={json} />
