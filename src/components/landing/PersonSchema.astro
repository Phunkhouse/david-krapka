---
import { t, type Locale } from '../../i18n'
import { urlFor } from '../../i18n/routes'

interface Props {
  locale: Locale
}

// schema.org Person for search engines (landing pages only). LinkedIn and
// GitHub join as `sameAs` once their real URLs are known (milestone 6 PR C).
const { locale } = Astro.props
const copy = t(locale)
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: copy.site.name,
  jobTitle: copy.site.role,
  description: copy.site.description,
  url: urlFor(locale, 'home'),
}
// A data block, not a script: CSP does not apply. Escape "<" so the JSON can
// never close the element.
const json = JSON.stringify(person).replace(/</g, '\\u003c')
---

<script type="application/ld+json" is:inline set:html={json} />
