---
import { Picture } from 'astro:assets'
import SectionHeading from '../SectionHeading.astro'
import { getCaseStudies } from '../../content/load'
import { previewFor } from '../../content/projects'
import { t, type Locale } from '../../i18n'
import { pathFor } from '../../i18n/routes'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { work } = t(locale).home
const { featured, inProgress } = work

// A card links only to a case study that is published (drafts are built on
// preview branches only, src/content/load.ts); the others stay plain cards.
const published = new Set((await getCaseStudies(locale)).map((s) => s.slug))
// A case study without a card here would never be linked; a mistyped slug in
// the dictionaries would leave its card plain. Fail the build instead.
const cardSlugs = [featured.slug, ...work.projects.map((p) => p.slug)]
for (const slug of published) {
  if (!cardSlugs.includes(slug)) {
    throw new Error(
      `Case study "${slug}" has no card on the landing page (${locale}). Check the slugs in src/i18n/${locale}.ts.`,
    )
  }
}
const hrefFor = (slug: string) =>
  published.has(slug) ? pathFor(locale, `work/${slug}`) : undefined
// Card art is the project's preview image (canvas page "Selected work
// previews"): a screenshot of its home page in a print-style browser window,
// 1200 × 630, cropped to the card.
const projects = work.projects.map((project) => ({
  ...project,
  preview: previewFor(project.slug),
  href: hrefFor(project.slug),
}))
const featuredPreview = previewFor(featured.slug)
const featuredHref = hrefFor(featured.slug)
const featuredSizes = '(min-width: 1100px) 560px, 100vw'
const cardSizes = '(min-width: 1100px) 25vw, (min-width: 720px) 50vw, 100vw'
---

<!--
  A linked card: the project name is the link, stretched over the whole card
  with ::after, so the link's name is just the project name and the text stays
  ordinary text. The lift (hover and keyboard focus) is on the card.
-->
<section
  id="work"
  class="work surface-ink"
  aria-labelledby="work-title"
  tabindex="-1"
>
  <div class="inner">
    <div class="heading">
      <SectionHeading id="work-title">{work.title}</SectionHeading>
      <p class="intro">{work.intro}</p>
    </div>

    <article class:list={['featured', { 'is-link': featuredHref }]}>
      <div class="preview featured-art" aria-hidden="true">
        <Picture
          src={featuredPreview}
          alt=""
          formats={['avif', 'webp']}
          widths={[560, 800, 1200]}
          sizes={featuredSizes}
        />
      </div>
      <div class="featured-body">
        <p class="label">{featured.label}</p>
        <h3>
          {featuredHref ? (
            <a class="card-link" href={featuredHref}>
              {featured.name}
            </a>
          ) : (
            featured.name
          )}
        </h3>
        <p class="featured-text">
          <span class="long">{featured.text}</span>
          <span class="short">{featured.textShort}</span>
        </p>
        {featuredHref && (
          <span class="more" aria-hidden="true">
            →
          </span>
        )}
      </div>
    </article>

    <ul class="cards" role="list" aria-label={work.listLabel}>
      {projects.map((project) => (
        <li class:list={['card', { 'is-link': project.href }]}>
          <div class="preview card-preview" aria-hidden="true">
            <Picture
              src={project.preview}
              alt=""
              formats={['avif', 'webp']}
              widths={[400, 800]}
              sizes={cardSizes}
            />
          </div>
          <div class="card-body">
            <p class="label">{project.label}</p>
            <h3>
              {project.href ? (
                <a class="card-link" href={project.href}>
                  {project.name}
                </a>
              ) : (
                project.name
              )}
            </h3>
            <p>
              <span class="long">{project.text}</span>
              <span class="short">{project.textShort}</span>
            </p>
            {project.href && (
              <span class="more" aria-hidden="true">
                →
              </span>
            )}
          </div>
        </li>
      ))}
      <li class="card card--progress">
        <div class="card-art" aria-hidden="true">
          <span class="dots dots-pink"></span>
          <span class="initial-s">{inProgress.name[0]}</span>
        </div>
        <div class="card-body">
          <p class="label">{inProgress.label}</p>
          <h3>{inProgress.name}</h3>
          <p>
            <span class="long">{inProgress.text}</span>
            <span class="short">{inProgress.textShort}</span>
          </p>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .work {
    /* Mobile heading shadow; desktop below. Solid pink on ink. */
    --shadow-heading: 4px 3px 0 var(--pink);
    --focus-color: var(--yellow);

    border-top: var(--border);
  }

  .work:focus {
    outline: none;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-l);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--pad-section) var(--pad-inline);
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .work :global(h2) {
    color: var(--yellow);
  }

  .intro {
    max-width: 440px;
    color: var(--ink-soft);
    font-size: var(--text-body-lg);
  }

  .long {
    display: none;
  }

  /* Featured card */
  .featured {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 8px 8px 0 var(--pink);
  }

  /* Preview images (1200 × 630): the picture fills the box and is cropped
     around its centre, where the browser window sits. */
  .preview {
    position: relative;
    overflow: hidden;
    background: var(--tint);
  }

  .preview :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .featured-art {
    height: 230px;
    border-bottom: var(--border);
  }

  .featured-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: var(--gap-m);
  }

  .featured-body h3 {
    font-size: var(--text-feature);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .featured-text {
    max-width: 520px;
    font-size: var(--text-body-lg);
  }

  /* Project cards: stacked on mobile, as the "Next project" card is, so the
     preview has room to show the window. Systerna stays a row. */
  .cards {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    color: var(--ink);
  }

  .card-preview {
    height: 150px;
    border-bottom: var(--border);
  }

  .card-art {
    position: relative;
    overflow: hidden;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: var(--gap-s);
  }

  .card-body h3 {
    font-size: var(--text-card);
  }

  .card-body p:last-child {
    font-size: 14px;
    line-height: 1.5;
  }

  /* In progress: dashed outline on the ink section, not a link */
  .card--progress {
    display: grid;
    grid-template-columns: 98px minmax(0, 1fr);
    border: 3px dashed var(--ink-line);
    background: none;
    color: var(--paper);
  }

  .card--progress .card-art {
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 0;
  }

  .card--progress .label {
    color: var(--yellow);
  }

  .card--progress .card-body p:last-child {
    color: var(--ink-soft);
  }

  .dots {
    position: absolute;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    opacity: 0.8;
  }

  .initial-s {
    position: relative;
    color: var(--yellow);
    font-family: var(--family-display);
    font-weight: 900;
    font-size: 44px;
    line-height: 1;
  }

  /* Linked cards: the name's link covers the card. Hover and keyboard focus
     lift the card 4px up and left over 0.2s while its hard shadow grows by
     the same 4px, so the shadow's far edge stays put. */
  .featured,
  .card {
    position: relative;
  }

  .featured.is-link,
  .card.is-link {
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .card.is-link {
    box-shadow: 0 0 0 var(--pink);
  }

  .card-link {
    text-decoration: none;
  }

  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-link:focus-visible {
    outline: none;
  }

  .card-link:focus-visible::after {
    outline: var(--focus-width) solid var(--focus-color);
    outline-offset: var(--focus-offset);
  }

  /* A linked card ends in a bare arrow: the card's link already names the
     project, so the arrow is decoration and hidden from screen readers. It
     sits bottom right and nudges right with the card's lift. */
  .more {
    align-self: flex-end;
    margin-top: auto;
    color: var(--ink);
    font-family: var(--family-body);
    font-weight: 700;
    font-size: 32px;
    line-height: 1;
    transition: transform 0.2s;
    /* Its nudge (a transform) lifts it above the card's link overlay, so let
       clicks pass through to the link. */
    pointer-events: none;
  }

  /* The arrow sits at the bottom of every linked card, whatever its text
     length. */
  .is-link .card-body,
  .is-link .featured-body {
    flex: 1;
  }

  .is-link:has(.card-link:focus-visible) .more {
    transform: translateX(4px);
  }

  .featured.is-link:has(.card-link:focus-visible) {
    transform: translate(-4px, -4px);
    box-shadow: 12px 12px 0 var(--pink);
  }

  .card.is-link:has(.card-link:focus-visible) {
    transform: translate(-4px, -4px);
    box-shadow: 4px 4px 0 var(--pink);
  }

  @media (hover: hover) {
    .featured.is-link:hover {
      transform: translate(-4px, -4px);
      box-shadow: 12px 12px 0 var(--pink);
    }

    .card.is-link:hover {
      transform: translate(-4px, -4px);
      box-shadow: 4px 4px 0 var(--pink);
    }

    .is-link:hover .card-link {
      text-decoration: underline;
      text-decoration-thickness: 3px;
    }

    .is-link:hover .more {
      transform: translateX(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured.is-link,
    .card.is-link,
    .more {
      transition: none;
    }
  }

  /* From 720 px: long copy, stacked cards in two columns */
  @media (min-width: 720px) {
    .work {
      --shadow-heading: 6px 5px 0 var(--pink);
    }

    .heading {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--gap-m);
    }

    .inner {
      gap: var(--gap-xl);
    }

    .long {
      display: inline;
    }

    .short {
      display: none;
    }

    .featured {
      box-shadow: 12px 12px 0 var(--pink);
    }

    .featured.is-link:has(.card-link:focus-visible) {
      box-shadow: 16px 16px 0 var(--pink);
    }

    @media (hover: hover) {
      .featured.is-link:hover {
        box-shadow: 16px 16px 0 var(--pink);
      }
    }

    /* Full width and short: follow the image's shape, up to 420 px, so the
       window's address bar is not cropped away. */
    .featured-art {
      height: auto;
      max-height: 420px;
      aspect-ratio: 1200 / 630;
    }

    .featured-body {
      justify-content: center;
      gap: 20px;
      padding: var(--gap-xl);
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gap-l);
    }

    .card-preview {
      height: 190px;
    }

    .card-art {
      height: 190px;
    }

    .card--progress {
      display: flex;
      grid-template-columns: none;
    }

    .card-body {
      gap: 10px;
      padding: 26px;
    }

    .card-body p:last-child {
      font-size: var(--text-body);
      line-height: var(--leading-body);
    }

    .dots {
      width: 150px;
      height: 150px;
    }

    .initial-s {
      font-size: 80px;
    }
  }

  @media (min-width: 1100px) {
    /* Art and text side by side; the art column is 560 px on the mockup. */
    .featured {
      display: grid;
      grid-template-columns: clamp(380px, 42vw, 560px) minmax(0, 1fr);
    }

    .featured-art {
      height: 420px;
      max-height: none;
      aspect-ratio: auto;
      border-right: var(--border);
      border-bottom: 0;
    }

    .featured-body {
      padding: var(--gap-2xl);
    }

    .cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
