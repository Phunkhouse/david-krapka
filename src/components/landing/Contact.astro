---
import { t, type Locale } from '../../i18n'
import { contactEmail, profiles } from '../../content/profiles'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { contact } = t(locale).home

// Both cards open an email with a prefilled subject. No form, nothing stored.
const mailto = (subject: string) =>
  `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}`
---

<!--
  Invitation to talk only: no prices, rates, terms or availability claims
  while the trade is suspended (LEG-001, decision 0008).
-->
<section
  id="contact"
  class="contact paper-yellow rollers"
  tabindex="-1"
  aria-labelledby="contact-title"
>
  <span class="question question--pink" aria-hidden="true">
    ?
  </span>
  <span class="question halftone" aria-hidden="true">
    ?
  </span>

  <div class="inner">
    <h2 id="contact-title">{contact.title}</h2>

    <div class="cards">
      <div class="card card--paper">
        <h3>{contact.hire.title}</h3>
        <p>
          <span class="long">{contact.hire.text}</span>
          <span class="short">{contact.hire.textShort}</span>
        </p>
        <a href={mailto(contact.hire.subject)}>{contact.hire.link}</a>
      </div>
      <div class="card card--ink">
        <h3>{contact.project.title}</h3>
        <p>{contact.project.text}</p>
        <a href={mailto(contact.project.subject)}>{contact.project.link}</a>
      </div>
    </div>

    <ul class="links" role="list">
      <li>
        <a
          href={`mailto:${contactEmail}`}
          aria-label={`${contact.email}: ${contactEmail}`}
          title={contactEmail}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="stroke">
            <rect x="3" y="5.5" width="18" height="13" rx="1" />
            <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
          </svg>
        </a>
      </li>
      <li>
        <a
          href={profiles.linkedin}
          rel="noopener"
          aria-label={contact.linkedin}
          title={contact.linkedin}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 9h3.5v11H4z" />
            <circle cx="5.75" cy="5.25" r="2" />
            <path d="M10 9h3.4v1.6c.5-.9 1.7-1.9 3.5-1.9 3.6 0 4.1 2.3 4.1 5.3V20h-3.5v-5.3c0-1.3 0-2.9-1.8-2.9s-2.1 1.4-2.1 2.8V20H10z" />
          </svg>
        </a>
      </li>
      <li>
        <a
          href={profiles.github}
          rel="noopener"
          aria-label={contact.github}
          title={contact.github}
        >
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .contact {
    /* Rollers: 14 px on mobile, fluid 22 to 36 px from 720 px. */
    --roller-width: 14px;

    position: relative;
    overflow: hidden;
    border-top: var(--border);
  }

  .contact:focus {
    outline: none;
  }

  .inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--pad-section) 20px;
  }

  h2 {
    max-width: 900px;
    font-size: var(--text-contact);
    line-height: 0.98;
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 880px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px;
    border: var(--border);
  }

  .card h3 {
    font-family: var(--family-body);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
    text-transform: none;
  }

  .card p {
    line-height: 1.55;
  }

  .card a {
    font-weight: 700;
  }

  .card--paper {
    background: var(--paper);
  }

  .card--ink {
    --focus-color: var(--yellow);

    background: var(--ink);
    color: var(--paper);
    box-shadow: 6px 6px 0 var(--pink);
  }

  .card--ink a {
    color: var(--yellow);
  }

  .long {
    display: none;
  }

  /* Email, LinkedIn and GitHub as square icon buttons: paper tile, ink
     border and a hard ink shadow; they lift like the work cards. 48 px is
     a comfortable tap target. Each link is named by its aria-label. */
  .links {
    display: flex;
    gap: 14px;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: var(--border);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .links svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .links svg.stroke {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .links a:focus-visible {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--ink);
  }

  @media (hover: hover) {
    .links a:hover {
      transform: translate(-3px, -3px);
      box-shadow: 6px 6px 0 var(--ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .links a {
      transition: none;
    }
  }

  /* Huge halftone "?" bleeding off the bottom right, behind the content. */
  .question {
    position: absolute;
    right: 22px;
    bottom: -40px;
    font-family: var(--family-display);
    font-weight: 900;
    font-size: 200px;
    line-height: 1;
    opacity: 0.5;
    --dot: 3.4px;
    --grid: 10px;
  }

  .question--pink {
    display: none;
  }

  @media (min-width: 720px) {
    .contact {
      --roller-width: var(--roller);
    }

    .inner {
      gap: 40px;
      padding-inline: 48px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gap-m);
    }

    .card {
      gap: 14px;
      padding: 30px;
    }

    .card--ink {
      box-shadow: 8px 8px 0 var(--pink);
    }

    .long {
      display: inline;
    }

    .short {
      display: none;
    }

    .question {
      right: 90px;
      bottom: -70px;
      font-size: 400px;
      opacity: 1;
    }

    .question--pink {
      display: block;
      right: 70px;
      bottom: -55px;
      color: var(--pink);
      opacity: 0.5;
      mix-blend-mode: multiply;
    }
  }

  @media (min-width: 1100px) {
    .inner {
      padding-inline: 60px;
    }

    .question {
      bottom: -165px;
      font-size: 620px;
      --dot: 6px;
      --grid: 18px;
    }

    .question--pink {
      bottom: -150px;
    }
  }
</style>
