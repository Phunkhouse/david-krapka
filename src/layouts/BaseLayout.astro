---
import { Font } from 'astro:assets'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { isLocale, t, type Locale } from '../i18n'
import { alternatesFor, urlFor, type RouteKey } from '../i18n/routes'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Pages that exist in both languages get canonical and hreflang links. */
  route?: RouteKey
  /** Overrides the locale Astro derives from the URL (used by the 404 page). */
  locale?: Locale
  /** Full-bleed content (the landing page): no padding or max width on main. */
  bleed?: boolean
}

const { title, description, route, locale: localeProp, bleed } = Astro.props
const locale: Locale =
  localeProp ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : 'en')
const copy = t(locale)
const alternates = route ? alternatesFor(route) : []
// Pages without a route (404, specimen) switch to the home pages.
const shellRoute: RouteKey = route ?? 'home'
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-mono" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {route && <link rel="canonical" href={urlFor(locale, route)} />}
    {alternates.map(({ locale: alt, href }) => (
      <link rel="alternate" hreflang={alt} href={href} />
    ))}
    {route && (
      <link rel="alternate" hreflang="x-default" href={urlFor('en', route)} />
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {copy.skipLink}
    </a>
    <Header locale={locale} route={shellRoute} />
    <main id="main" tabindex="-1" class:list={{ bleed }}>
      <slot />
    </main>
    <Footer locale={locale} route={shellRoute} />
  </body>
</html>

<style>
  main {
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--gap-xl) var(--pad-inline) 0;
  }

  main.bleed {
    max-width: none;
    padding: 0;
  }

  /* Full-bleed pages end in their own section: no gap above the footer. */
  main.bleed ~ :global(.site-footer) {
    margin-top: 0;
  }

  main:focus {
    outline: none;
  }

  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1 0 auto;
    width: 100%;
  }
</style>
