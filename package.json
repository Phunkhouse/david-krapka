{
  "name": "david-krapka",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "check:fonts": "node scripts/check-fonts.mjs",
    "check:drafts": "node scripts/check-drafts.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm check:fonts && pnpm check:drafts",
    "preview:cloudflare": "wrangler dev",
    "placeholders": "node scripts/placeholders.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.2",
    "astro": "^7.4.5"
  },
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "wrangler": "4.157.0"
  }
